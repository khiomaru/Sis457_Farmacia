@model WebFarmacia.Models.Reserva

@{
    ViewData["Title"] = "Detalles de Reserva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section -->
<section class="hero-wrap hero-wrap-2" style="background-image: url('images/bg_2.jpg');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate mb-5 text-center">
                <p class="breadcrumbs mb-2"><span class="mr-2"><a href="index.html">Home <i class="fa fa-chevron-right"></i></a></span> <span><a asp-action="Index">Reservas <i class="fa fa-chevron-right"></i></a></span></p>
                <h2 class="mb-0 bread">Detalles de Reserva</h2>
            </div>
        </div>
    </div>
</section>

<!-- Main Content -->
<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Reserva #@Model.IdReserva</h4>
                    </div>
                    <div class="card-body p-4">
                        <!-- Status Badge -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="badge badge-@GetStatusBadgeClass(Model.Estado) fs-6">
                                            @Model.Estado
                                        </span>
                                    </div>
                                    <div class="text-muted">
                                        <small>Registrado el: @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Cliente Information -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card border-light">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fa fa-user mr-2"></i>Información del Cliente</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p><strong>Nombre:</strong> @Model.IdClienteNavigation?.Nombres @Model.IdClienteNavigation?.Apellidos</p>
                                                <p><strong>Cédula:</strong> @Model.IdClienteNavigation?.CedulaIdentidad</p>
                                                <p><strong>Teléfono:</strong> @Model.TelefonoContacto</p>
                                            </div>
                                            <div class="col-md-6">
                                                <p><strong>Email:</strong> @Model.EmailContacto ?? "No especificado"</p>
                                                <p><strong>Usuario Registro:</strong> @Model.UsuarioRegistro</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Medicamento Information -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card border-light">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fa fa-pills mr-2"></i>Información del Medicamento</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p><strong>Nombre:</strong> @Model.IdMedicamentoNavigation?.Nombre</p>
                                                <p><strong>Código:</strong> @Model.IdMedicamentoNavigation?.Codigo</p>
                                                <p><strong>Laboratorio:</strong> @Model.IdMedicamentoNavigation?.IdLaboratorioNavigation?.Nombre</p>
                                            </div>
                                            <div class="col-md-6">
                                                <p><strong>Categoría:</strong> @Model.IdMedicamentoNavigation?.IdCategoriaNavigation?.Nombre</p>
                                                <p><strong>Precio Unitario:</strong> @Model.IdMedicamentoNavigation?.PrecioVenta.ToString("C")</p>
                                                <p><strong>Stock Disponible:</strong> @Model.IdMedicamentoNavigation?.Stock</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Reserva Details -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card border-light">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fa fa-calendar-alt mr-2"></i>Detalles de la Reserva</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <p><strong>Cantidad:</strong> @Model.Cantidad</p>
                                                <p><strong>Total:</strong> @Model.Total.ToString("C")</p>
                                            </div>
                                            <div class="col-md-4">
                                                <p><strong>Fecha Reserva:</strong> @Model.FechaReserva.ToString("dd/MM/yyyy")</p>
                                                <p><strong>Fecha Vencimiento:</strong> @Model.FechaVencimientoReserva.ToString("dd/MM/yyyy")</p>
                                            </div>
                                            <div class="col-md-4">
                                                <p><strong>Motivo:</strong> @Model.Motivo</p>
                                                <p><strong>Notas:</strong> @(Model.Notas ?? "No hay notas")</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between">
                                    <a asp-action="Index" class="btn btn-secondary">
                                        <i class="fa fa-arrow-left"></i> Volver a la Lista
                                    </a>
                                    <div class="btn-group">
                                        @if (Model.Estado == "PENDIENTE")
                                        {
                                            <a asp-action="Confirmar" asp-route-id="@Model.IdReserva" class="btn btn-success">
                                                <i class="fa fa-check"></i> Confirmar
                                            </a>
                                            <a asp-action="Cancelar" asp-route-id="@Model.IdReserva" class="btn btn-warning">
                                                <i class="fa fa-times"></i> Cancelar
                                            </a>
                                        }
                                        <a asp-action="Edit" asp-route-id="@Model.IdReserva" class="btn btn-primary">
                                            <i class="fa fa-edit"></i> Editar
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@Model.IdReserva" class="btn btn-danger">
                                            <i class="fa fa-trash"></i> Eliminar
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@functions {
    public string GetStatusBadgeClass(string estado)
    {
        return estado switch
        {
            "PENDIENTE" => "warning",
            "CONFIRMADA" => "success",
            "CANCELADA" => "danger",
            "EXPIRADA" => "secondary",
            _ => "light"
        };
    }
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize tooltips
            $('[title]').tooltip();
        });
    </script>
}