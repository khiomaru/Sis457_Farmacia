@model WebFarmacia.Models.Medicamento

@{
    ViewData["Title"] = "Detalle Medicamento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Detalle Medicamento</h1>

<div>
    <h4>Medicamento</h4>
   
    <dl class="row">
        <dt class="col-sm-2">Código</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Codigo)
        </dd>
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
        <dt class="col-sm-2">Composición</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Composicion)
        </dd>
        <dt class="col-sm-2">Categoría</dt>
        <dd class="col-sm-10">
            @(Model.IdCategoriaNavigation?.Nombre ?? "N/A")
        </dd>
        <dt class="col-sm-2">Laboratorio</dt>
        <dd class="col-sm-10">
            @(Model.IdLaboratorioNavigation?.Nombre ?? "N/A")
        </dd>
        <dt class="col-sm-2">Fecha de Vencimiento</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaVencimiento)
        </dd>
        <dt class="col-sm-2">Stock</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Stock)
        </dd>
        <dt class="col-sm-2">Precio de Venta</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PrecioVenta)
        </dd>
        <dt class="col-sm-2">Requiere Receta</dt>
        <dd class="col-sm-10">
            @(Model.RequiereReceta ? "Sí" : "No")
        </dd>
        <dt class="col-sm-2">Usuario de Registro</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.UsuarioRegistro)
        </dd>
        <dt class="col-sm-2">Fecha de Registro</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaRegistro)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id"><i class="fa fa-edit"></i> Editar</a> |
    <a asp-action="Index"><i class="fa fa-arrow-left"></i> Volver a la lista</a>
</div>
