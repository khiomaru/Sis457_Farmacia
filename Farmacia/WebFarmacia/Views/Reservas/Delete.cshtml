@model WebFarmacia.Models.Reserva

@{
    ViewData["Title"] = "Eliminar Reserva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section -->
<section class="hero-wrap hero-wrap-2" style="background-image: url('images/bg_2.jpg');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate mb-5 text-center">
                <p class="breadcrumbs mb-2"><span class="mr-2"><a href="index.html">Home <i class="fa fa-chevron-right"></i></a></span> <span><a asp-action="Index">Reservas <i class="fa fa-chevron-right"></i></a></span></p>
                <h2 class="mb-0 bread">Eliminar Reserva</h2>
            </div>
        </div>
    </div>
</section>

<!-- Main Content -->
<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-danger text-white">
                        <h4 class="mb-0">Confirmar Eliminación</h4>
                    </div>
                    <div class="card-body p-4">
                        <div class="alert alert-warning">
                            <i class="fa fa-exclamation-triangle mr-2"></i>
                            <strong>¿Está seguro que desea eliminar esta reserva?</strong> Esta acción no se puede deshacer.
                        </div>

                        <!-- Reserva Details -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card border-light">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0">Reserva #@Model.IdReserva</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p><strong>Cliente:</strong> @Model.IdClienteNavigation?.Nombres @Model.IdClienteNavigation?.Apellidos</p>
                                                <p><strong>Medicamento:</strong> @Model.IdMedicamentoNavigation?.Nombre</p>
                                                <p><strong>Cantidad:</strong> @Model.Cantidad</p>
                                            </div>
                                            <div class="col-md-6">
                                                <p><strong>Total:</strong> @Model.Total.ToString("C")</p>
                                                <p><strong>Estado:</strong> <span class="badge badge-@GetStatusBadgeClass(Model.Estado)">@Model.Estado</span></p>
                                                <p><strong>Fecha Reserva:</strong> @Model.FechaReserva.ToString("dd/MM/yyyy")</p>
                                            </div>
                                        </div>
                                        <div class="row mt-3">
                                            <div class="col-12">
                                                <p><strong>Motivo:</strong> @Model.Motivo</p>
                                                <p><strong>Notas:</strong> @(Model.Notas ?? "No hay notas")</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Delete Form -->
                        <form asp-action="Delete">
                            <input type="hidden" asp-for="IdReserva" />
                            
                            <!-- Action Buttons -->
                            <div class="form-group">
                                <div class="d-flex justify-content-between">
                                    <a asp-action="Index" class="btn btn-secondary">
                                        <i class="fa fa-arrow-left"></i> Volver a la Lista
                                    </a>
                                    <button type="submit" class="btn btn-danger">
                                        <i class="fa fa-trash"></i> Eliminar Reserva
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@functions {
    public string GetStatusBadgeClass(string estado)
    {
        return estado switch
        {
            "PENDIENTE" => "warning",
            "CONFIRMADA" => "success",
            "CANCELADA" => "danger",
            "EXPIRADA" => "secondary",
            _ => "light"
        };
    }
}