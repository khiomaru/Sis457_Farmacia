@model WebFarmacia.Models.Reserva

@{
    ViewData["Title"] = "Editar Reserva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section -->
<section class="hero-wrap hero-wrap-2" style="background-image: url('images/bg_2.jpg');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate mb-5 text-center">
                <p class="breadcrumbs mb-2"><span class="mr-2"><a href="index.html">Home <i class="fa fa-chevron-right"></i></a></span> <span><a asp-action="Index">Reservas <i class="fa fa-chevron-right"></i></a></span></p>
                <h2 class="mb-0 bread">Editar Reserva</h2>
            </div>
        </div>
    </div>
</section>

<!-- Main Content -->
<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Editar Reserva #@Model.IdReserva</h4>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="Edit">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                            <input type="hidden" asp-for="IdReserva" />

                            <!-- Cliente Selection -->
                            <div class="form-group">
                                <label asp-for="IdCliente" class="control-label font-weight-semibold">Cliente</label>
                                <select asp-for="IdCliente" class="form-control" asp-items="ViewBag.IdCliente">
                                    <option value="">-- Seleccione un cliente --</option>
                                </select>
                                <span asp-validation-for="IdCliente" class="text-danger"></span>
                            </div>

                            <!-- Medicamento Selection -->
                            <div class="form-group">
                                <label asp-for="IdMedicamento" class="control-label font-weight-semibold">Medicamento</label>
                                <select asp-for="IdMedicamento" class="form-control" asp-items="ViewBag.IdMedicamento">
                                    <option value="">-- Seleccione un medicamento --</option>
                                </select>
                                <span asp-validation-for="IdMedicamento" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <!-- Cantidad -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Cantidad" class="control-label font-weight-semibold">Cantidad</label>
                                        <input asp-for="Cantidad" class="form-control" placeholder="Ingrese la cantidad" />
                                        <span asp-validation-for="Cantidad" class="text-danger"></span>
                                        <small class="text-muted">Unidades disponibles: <span id="stockDisponible">0</span></small>
                                    </div>
                                </div>

                                <!-- Total (Readonly) -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Total" class="control-label font-weight-semibold">Total</label>
                                        <input asp-for="Total" class="form-control" readonly />
                                        <span asp-validation-for="Total" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Motivo -->
                            <div class="form-group">
                                <label asp-for="Motivo" class="control-label font-weight-semibold">Motivo de la Reserva</label>
                                <textarea asp-for="Motivo" class="form-control" rows="3" placeholder="Ingrese el motivo de la reserva"></textarea>
                                <span asp-validation-for="Motivo" class="text-danger"></span>
                            </div>

                            <!-- Notas -->
                            <div class="form-group">
                                <label asp-for="Notas" class="control-label font-weight-semibold">Notas Adicionales</label>
                                <textarea asp-for="Notas" class="form-control" rows="2" placeholder="Notas adicionales (opcional)"></textarea>
                                <span asp-validation-for="Notas" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <!-- Fecha Reserva -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="FechaReserva" class="control-label font-weight-semibold">Fecha de Reserva</label>
                                        <input asp-for="FechaReserva" class="form-control" type="date" />
                                        <span asp-validation-for="FechaReserva" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Fecha Vencimiento Reserva -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="FechaVencimientoReserva" class="control-label font-weight-semibold">Fecha Vencimiento Reserva</label>
                                        <input asp-for="FechaVencimientoReserva" class="form-control" type="date" />
                                        <span asp-validation-for="FechaVencimientoReserva" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <!-- Teléfono Contacto -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="TelefonoContacto" class="control-label font-weight-semibold">Teléfono de Contacto</label>
                                        <input asp-for="TelefonoContacto" class="form-control" placeholder="Ingrese teléfono de contacto" />
                                        <span asp-validation-for="TelefonoContacto" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Email Contacto -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="EmailContacto" class="control-label font-weight-semibold">Email de Contacto</label>
                                        <input asp-for="EmailContacto" class="form-control" type="email" placeholder="Ingrese email de contacto (opcional)" />
                                        <span asp-validation-for="EmailContacto" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Estado -->
                            <div class="form-group">
                                <label asp-for="Estado" class="control-label font-weight-semibold">Estado</label>
                                <select asp-for="Estado" class="form-control">
                                    <option value="PENDIENTE">Pendiente</option>
                                    <option value="CONFIRMADA">Confirmada</option>
                                    <option value="CANCELADA">Cancelada</option>
                                    <option value="EXPIRADA">Expirada</option>
                                </select>
                                <span asp-validation-for="Estado" class="text-danger"></span>
                            </div>

                            <!-- Hidden Fields -->
                            <input type="hidden" asp-for="UsuarioRegistro" />
                            <input type="hidden" asp-for="FechaRegistro" />

                            <!-- Action Buttons -->
                            <div class="form-group mt-4">
                                <div class="d-flex justify-content-between">
                                    <a asp-action="Index" class="btn btn-secondary">
                                        <i class="fa fa-arrow-left"></i> Volver a la Lista
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa fa-save"></i> Guardar Cambios
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Medicamento change event
            $('#IdMedicamento').change(function() {
                var medicamentoId = $(this).val();
                if (medicamentoId) {
                    $.ajax({
                        url: '@Url.Action("GetMedicamentoInfo", "Reservas")',
                        type: 'GET',
                        data: { id: medicamentoId },
                        success: function(data) {
                            $('#stockDisponible').text(data.stock);
                            $('#Cantidad').attr('max', data.stock);
                        },
                        error: function() {
                            $('#stockDisponible').text('0');
                        }
                    });
                } else {
                    $('#stockDisponible').text('0');
                }
            });

            // Calculate total when quantity changes
            $('#Cantidad').on('input', function() {
                var medicamentoId = $('#IdMedicamento').val();
                var cantidad = $(this).val();
                
                if (medicamentoId && cantidad) {
                    $.ajax({
                        url: '@Url.Action("CalculateTotal", "Reservas")',
                        type: 'GET',
                        data: { 
                            medicamentoId: medicamentoId,
                            cantidad: cantidad 
                        },
                        success: function(data) {
                            $('#Total').val(data.total.toFixed(2));
                        },
                        error: function() {
                            $('#Total').val('0.00');
                        }
                    });
                } else {
                    $('#Total').val('0.00');
                }
            });

            // Load initial values
            $('#IdMedicamento').trigger('change');
            $('#Cantidad').trigger('input');

            // Validate dates
            $('#FechaVencimientoReserva').change(function() {
                var fechaReserva = new Date($('#FechaReserva').val());
                var fechaVencimiento = new Date($(this).val());
                
                if (fechaVencimiento <= fechaReserva) {
                    alert('La fecha de vencimiento debe ser posterior a la fecha de reserva.');
                    $(this).val($('#FechaReserva').val());
                }
            });
        });
    </script>
}