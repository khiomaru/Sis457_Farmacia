@model WebFarmacia.Models.Medicamento

@{
    ViewData["Title"] = "Crear Medicamento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="site-section">
  <div class="container">
    <div class="row">
      <div class="col-md-6">
        <h2 class="text-black mb-4">Crear Nuevo Medicamento</h2>
        
        <form asp-action="Create">
          <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
          
          <div class="form-group">
            <label asp-for="Codigo" class="font-weight-bold">Código</label>
            <input asp-for="Codigo" class="form-control" placeholder="Ingrese código del medicamento" />
            <span asp-validation-for="Codigo" class="text-danger"></span>
          </div>
          
          <div class="form-group">
            <label asp-for="Nombre" class="font-weight-bold">Nombre</label>
            <input asp-for="Nombre" class="form-control" placeholder="Ingrese nombre del medicamento" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
          </div>
          
          <div class="form-group">
            <label asp-for="Descripcion" class="font-weight-bold">Descripción</label>
            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Ingrese descripción del medicamento"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
          </div>
          
          <div class="form-group">
            <label asp-for="Composicion" class="font-weight-bold">Composición</label>
            <textarea asp-for="Composicion" class="form-control" rows="2" placeholder="Ingrese composición del medicamento"></textarea>
            <span asp-validation-for="Composicion" class="text-danger"></span>
          </div>
          
          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label asp-for="IdCategoria" class="font-weight-bold">Categoría</label>
                <select asp-for="IdCategoria" class="form-control" asp-items="ViewBag.IdCategoria">
                  <option value="">-- Seleccione una categoría --</option>
                </select>
                <span asp-validation-for="IdCategoria" class="text-danger"></span>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label asp-for="IdLaboratorio" class="font-weight-bold">Laboratorio</label>
                <select asp-for="IdLaboratorio" class="form-control" asp-items="ViewBag.IdLaboratorio">
                  <option value="">-- Seleccione un laboratorio --</option>
                </select>
                <span asp-validation-for="IdLaboratorio" class="text-danger"></span>
              </div>
            </div>
          </div>
          
          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label asp-for="FechaVencimiento" class="font-weight-bold">Fecha de Vencimiento</label>
                <input asp-for="FechaVencimiento" class="form-control" type="date" />
                <span asp-validation-for="FechaVencimiento" class="text-danger"></span>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label asp-for="Stock" class="font-weight-bold">Stock</label>
                <input asp-for="Stock" class="form-control" type="number" min="0" placeholder="0" />
                <span asp-validation-for="Stock" class="text-danger"></span>
              </div>
            </div>
          </div>
          
          <div class="form-group">
            <label asp-for="PrecioVenta" class="font-weight-bold">Precio de Venta</label>
            <div class="input-group">
              <div class="input-group-prepend">
                <span class="input-group-text">Bs.</span>
              </div>
              <input asp-for="PrecioVenta" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
            </div>
            <span asp-validation-for="PrecioVenta" class="text-danger"></span>
          </div>
          
          <div class="form-group">
            <div class="custom-control custom-checkbox">
              <input type="checkbox" asp-for="RequiereReceta" class="custom-control-input" />
              <label asp-for="RequiereReceta" class="custom-control-label">Requiere Receta Médica</label>
            </div>
            <span asp-validation-for="RequiereReceta" class="text-danger"></span>
          </div>
          
          <div class="form-group mt-4">
            <button type="submit" class="btn btn-primary">
              <span class="icon-save"></span> Crear Medicamento
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary ml-2">
              <span class="icon-arrow-left"></span> Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
