    // Generic fake DbSet to mimic minimal EF behaviour used by CLN layer
    public class FakeDbSet<T> : IEnumerable<T>
    {
        private readonly List<T> _items = new List<T>();

        public void Add(T item)
        {
            _items.Add(item);
        }

        public T Find(int id)
        {
            // Attempt to find property named 'id' or 'Id'
            var pi = typeof(T).GetProperty("id", BindingFlags.Instance | BindingFlags.Public | BindingFlags.IgnoreCase);
            if (pi == null) return default(T);
            return _items.FirstOrDefault(x =>
            {
                var val = pi.GetValue(x);
                if (val == null) return false;
                try
                {
                    return Convert.ToInt32(val) == id;
                }
                catch { return false; }
            });
        }

        public bool Any(Func<T, bool> predicate)
        {
            return _items.Any(predicate);
        }

        public IEnumerable<T> Where(Func<T, bool> predicate)
        {
            return _items.Where(predicate);
        }

        public T FirstOrDefault(Func<T, bool> predicate)
        {
            return _items.FirstOrDefault(predicate);
        }

        public List<T> ToList()
        {
            return _items.ToList();
        }

        public IEnumerator<T> GetEnumerator()
        {
            return _items.GetEnumerator();
        }

        IEnumerator IEnumerable.GetEnumerator()
        {
            return GetEnumerator();
        }
    }

