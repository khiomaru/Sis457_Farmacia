@model IEnumerable<WebFarmacia.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section -->
<section class="hero-wrap hero-wrap-2" style="background-image: url('images/bg_2.jpg');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate mb-5 text-center">
                <p class="breadcrumbs mb-2"><span class="mr-2"><a href="index.html">Home <i class="fa fa-chevron-right"></i></a></span> <span>Reservas <i class="fa fa-chevron-right"></i></span></p>
                <h2 class="mb-0 bread">Gestión de Reservas</h2>
            </div>
        </div>
    </div>
</section>

<!-- Main Content -->
<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-10">
                <!-- Action Bar -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="ftco-animate">Reservas de Medicamentos</h4>
                        <p class="text-muted">Gestiona las reservas y apartados de medicamentos</p>
                    </div>
                    <div>
                        <a asp-action="Create" class="btn btn-primary py-2 px-4">
                            <i class="fa fa-plus"></i> Nueva Reserva
                        </a>
                    </div>
                </div>

                <!-- Advanced Filters -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h6 class="mb-0">
                            <i class="fa fa-filter mr-2"></i>Filtros Avanzados
                        </h6>
                    </div>
                    <div class="card-body">
                        <form asp-action="Index" method="get" id="filterForm">
                            <div class="row">
                                <!-- Search -->
                                <div class="col-md-4 mb-3">
                                    <label for="searchString" class="form-label font-weight-semibold">
                                        <i class="fa fa-search mr-1"></i>Buscar
                                    </label>
                                    <input type="text" class="form-control" id="searchString" name="searchString"
                                           placeholder="Cliente, medicamento, cédula..."
                                           value="@ViewData["SearchString"]" />
                                    <small class="text-muted">Busca por nombre, cédula, medicamento o motivo</small>
                                </div>

                                <!-- Estado Filter -->
                                <div class="col-md-3 mb-3">
                                    <label for="estadoFilter" class="form-label font-weight-semibold">
                                        <i class="fa fa-flag mr-1"></i>Estado
                                    </label>
                                    <select class="form-control" id="estadoFilter" name="estadoFilter">
                                        <option value="">Todos los estados</option>
                                        <option value="PENDIENTE" selected="@(ViewData["EstadoFilter"]?.ToString() == "PENDIENTE")">Pendientes</option>
                                        <option value="CONFIRMADA" selected="@(ViewData["EstadoFilter"]?.ToString() == "CONFIRMADA")">Confirmadas</option>
                                        <option value="CANCELADA" selected="@(ViewData["EstadoFilter"]?.ToString() == "CANCELADA")">Canceladas</option>
                                        <option value="EXPIRADA" selected="@(ViewData["EstadoFilter"]?.ToString() == "EXPIRADA")">Expiradas</option>
                                    </select>
                                </div>

                                <!-- Fecha Inicio -->
                                <div class="col-md-2 mb-3">
                                    <label for="fechaInicio" class="form-label font-weight-semibold">
                                        <i class="fa fa-calendar-plus mr-1"></i>Fecha Desde
                                    </label>
                                    <input type="date" class="form-control" id="fechaInicio" name="fechaInicio"
                                           value="@ViewData["FechaInicio"]" />
                                </div>

                                <!-- Fecha Fin -->
                                <div class="col-md-2 mb-3">
                                    <label for="fechaFin" class="form-label font-weight-semibold">
                                        <i class="fa fa-calendar-minus mr-1"></i>Fecha Hasta
                                    </label>
                                    <input type="date" class="form-control" id="fechaFin" name="fechaFin"
                                           value="@ViewData["FechaFin"]" />
                                </div>

                                <!-- Buttons -->
                                <div class="col-md-1 mb-3 d-flex align-items-end">
                                    <div class="btn-group-vertical w-100">
                                        <button type="submit" class="btn btn-primary btn-sm mb-1" title="Aplicar filtros">
                                            <i class="fa fa-filter"></i>
                                        </button>
                                        <button type="button" class="btn btn-secondary btn-sm" onclick="clearFilters()" title="Limpiar filtros">
                                            <i class="fa fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Quick Filter Pills -->
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="setQuickFilter('')">
                                Todas <span class="badge badge-primary ml-1">@Model.Count()</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning" onclick="setQuickFilter('PENDIENTE')">
                                Pendientes <span class="badge badge-warning ml-1">@Model.Count(r => r.Estado == "PENDIENTE")</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success" onclick="setQuickFilter('CONFIRMADA')">
                                Confirmadas <span class="badge badge-success ml-1">@Model.Count(r => r.Estado == "CONFIRMADA")</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="setQuickFilter('CANCELADA')">
                                Canceladas <span class="badge badge-danger ml-1">@Model.Count(r => r.Estado == "CANCELADA")</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setQuickFilter('EXPIRADA')">
                                Expiradas <span class="badge badge-secondary ml-1">@Model.Count(r => r.Estado == "EXPIRADA")</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Reservas Table -->
                <div class="table-responsive bg-white p-4 rounded shadow-sm">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Medicamento</th>
                                <th>Cantidad</th>
                                <th>Fecha Reserva</th>
                                <th>Fecha Vencimiento</th>
                                <th>Estado</th>
                                <th>Total</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model == null || !Model.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4">
                                        <div class="text-muted">
                                            <i class="fa fa-calendar-times fa-3x mb-3"></i>
                                            <p>No se encontraron reservas</p>
                                            <a asp-action="Create" class="btn btn-sm btn-primary">Crear primera reserva</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    <tr data-status="@item.Estado">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="mr-3">
                                                    <div class="icon-circle bg-primary text-white">
                                                        <i class="fa fa-user"></i>
                                                    </div>
                                                </div>
                                                <div>
                                                    <div class="font-weight-semibold">@item.IdClienteNavigation?.Nombres @item.IdClienteNavigation?.Apellidos</div>
                                                    <small class="text-muted">@item.IdClienteNavigation?.CedulaIdentidad</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="font-weight-semibold">@item.IdMedicamentoNavigation?.Nombre</div>
                                            <small class="text-muted">@item.IdMedicamentoNavigation?.IdLaboratorioNavigation?.Nombre</small>
                                        </td>
                                        <td>
                                            <span class="badge badge-info">@item.Cantidad</span>
                                        </td>
                                        <td>
                                            <div>@item.FechaReserva.ToString("dd/MM/yyyy")</div>
                                            <small class="text-muted">@item.FechaReserva.ToString("HH:mm")</small>
                                        </td>
                                        <td>
                                            <div>@item.FechaVencimientoReserva.ToString("dd/MM/yyyy")</div>
                                            <small class="text-muted">@item.FechaVencimientoReserva.ToString("HH:mm")</small>
                                        </td>
                                        <td>
                                            @switch (item.Estado)
                                            {
                                                case "PENDIENTE":
                                                    <span class="badge badge-warning">Pendiente</span>
                                                    break;
                                                case "CONFIRMADA":
                                                    <span class="badge badge-success">Confirmada</span>
                                                    break;
                                                case "CANCELADA":
                                                    <span class="badge badge-danger">Cancelada</span>
                                                    break;
                                                case "EXPIRADA":
                                                    <span class="badge badge-secondary">Expirada</span>
                                                    break;
                                                default:
                                                    <span class="badge badge-light">@item.Estado</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            <div class="font-weight-semibold text-primary">@item.Total.ToString("C")</div>
                                            <small class="text-muted">Bs.</small>
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-info" title="Ver detalles">
                                                    <i class="fa fa-eye"></i>
                                                </a>
                                                @if (item.Estado == "PENDIENTE")
                                                {
                                                    <a asp-action="Confirmar" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-success" title="Confirmar">
                                                        <i class="fa fa-check"></i>
                                                    </a>
                                                    <a asp-action="Cancelar" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-danger" title="Cancelar">
                                                        <i class="fa fa-times"></i>
                                                    </a>
                                                }
                                                <a asp-action="Delete" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                    <i class="fa fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Statistics Cards -->
                <div class="row mt-4">
                    <div class="col-md-3">
                        <div class="card border-primary">
                            <div class="card-body text-center">
                                <h5 class="card-title">Total Reservas</h5>
                                <h2 class="text-primary">@Model?.Count() ?? 0</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-warning">
                            <div class="card-body text-center">
                                <h5 class="card-title">Pendientes</h5>
                                <h2 class="text-warning">@Model?.Count(r => r.Estado == "PENDIENTE") ?? 0</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-success">
                            <div class="card-body text-center">
                                <h5 class="card-title">Confirmadas</h5>
                                <h2 class="text-success">@Model?.Count(r => r.Estado == "CONFIRMADA") ?? 0</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-info">
                            <div class="card-body text-center">
                                <h5 class="card-title">Total Valor</h5>
                                <h2 class="text-info">@Model?.Sum(r => r.Total).ToString("C") ?? "Bs.0"</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Quick filter functionality
            function setQuickFilter(estado) {
                $('#estadoFilter').val(estado);
                $('#filterForm').submit();
            }

            // Make function global
            window.setQuickFilter = setQuickFilter;

            // Clear filters function
            window.clearFilters = function() {
                $('#searchString').val('');
                $('#estadoFilter').val('');
                $('#fechaInicio').val('');
                $('#fechaFin').val('');
                $('#filterForm').submit();
            }

            // Auto-submit form when date inputs change
            $('#fechaInicio, #fechaFin').change(function() {
                $('#filterForm').submit();
            });

            // Auto-submit after 500ms of typing in search
            var searchTimeout;
            $('#searchString').on('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function() {
                    $('#filterForm').submit();
                }, 500);
            });

            // Auto-submit when estado changes
            $('#estadoFilter').change(function() {
                $('#filterForm').submit();
            });

            // Initialize tooltips
            $('[title]').tooltip();

            // Highlight search terms in table
            function highlightSearchTerm() {
                var searchTerm = $('#searchString').val().toLowerCase();
                if (searchTerm.length > 2) {
                    $('tbody tr').each(function() {
                        var $row = $(this);
                        var text = $row.text().toLowerCase();
                        if (text.includes(searchTerm)) {
                            $row.addClass('table-warning');
                        } else {
                            $row.removeClass('table-warning');
                        }
                    });
                } else {
                    $('tbody tr').removeClass('table-warning');
                }
            }

            // Apply highlighting
            highlightSearchTerm();
        });
    </script>
}

<style>
    .icon-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }
    
    .card {
        transition: transform 0.2s;
    }
    
    .card:hover {
        transform: translateY(-5px);
    }
</style>