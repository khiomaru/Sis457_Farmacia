// Provide minimal Include extension methods in the System.Data.Entity namespace so calls to .Include(...) compile
namespace System.Data.Entity
{
    public static class DummyIncludeExtensions
    {
        // For IEnumerable<T> usage
        public static IEnumerable<T> Include<T, TProperty>(this IEnumerable<T> source, Func<T, TProperty> path)
        {
            return source;
        }

        // For IQueryable<T> usage with expression (matches EF signature)
        public static IQueryable<T> Include<T, TProperty>(this IQueryable<T> source, Expression<Func<T, TProperty>> path)
        {
            return source;
        }
    }
