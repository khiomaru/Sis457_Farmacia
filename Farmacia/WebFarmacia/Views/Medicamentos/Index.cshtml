@model IEnumerable<WebFarmacia.Models.Medicamento>

@{
    ViewData["Title"] = "Medicamentos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="site-section">
  <div class="container">
    <div class="row mb-5">
      <div class="col-md-6 mb-5">
        <h2 class="text-uppercase">Medicamentos</h2>
      </div>
      <div class="col-md-6 mb-5 text-md-right">
        <a asp-action="Create" class="btn btn-primary">
          <span class="icon-plus"></span> Nuevo Medicamento
        </a>
      </div>
    </div>

    <div class="row">
      <div class="col-md-12">
        <div class="table-responsive">
          <table class="table table-hover">
            <thead class="thead-light">
              <tr>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Categoría</th>
                <th>Laboratorio</th>
                <th>Estado</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var item in Model)
              {
                <tr>
                  <td>
                    <strong>@Html.DisplayFor(modelItem => item.Nombre)</strong>
                    <br>
                    <small class="text-muted">@Html.DisplayFor(modelItem => item.Descripcion)</small>
                  </td>
                  <td>
                    <strong>Bs. @item.PrecioVenta.ToString("N2")</strong>
                  </td>
                  <td>
                    <span class="badge @(item.Stock > 10 ? "badge-success" : item.Stock > 0 ? "badge-warning" : "badge-danger")">
                      @Html.DisplayFor(modelItem => item.Stock)
                    </span>
                  </td>
                  <td>@(item.IdCategoriaNavigation?.Nombre ?? "N/A")</td>
                  <td>@(item.IdLaboratorioNavigation?.Nombre ?? "N/A")</td>
                  <td>
                    <span class="badge @(item.Estado == 1 ? "badge-success" : "badge-danger")">
                      @(item.Estado == 1 ? "Activo" : "Inactivo")
                    </span>
                  </td>
                  <td>
                    <div class="btn-group btn-group-sm" role="group">
                      <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Editar">
                        <span class="icon-edit"></span>
                      </a>
                      <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Detalles">
                        <span class="icon-eye"></span>
                      </a>
                      <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Eliminar">
                        <span class="icon-trash"></span>
                      </a>
                    </div>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
