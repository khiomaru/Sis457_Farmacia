    // Fake DbSet especializado para Medicamento
    public class FakeMedicamentoSet : IEnumerable<Medicamento>
    {
        private readonly List<Medicamento> _items = new List<Medicamento>();

        public void Add(Medicamento m)
        {
            _items.Add(m);
        }

        public Medicamento Find(int id)
        {
            return _items.FirstOrDefault(m => m.id == id);
        }

        public bool Any(Func<Medicamento, bool> predicate)
        {
            return _items.Any(predicate);
        }

        public IEnumerator<Medicamento> GetEnumerator()
        {
            return _items.GetEnumerator();
        }

        IEnumerator IEnumerable.GetEnumerator()
        {
            return GetEnumerator();
        }

        public List<Medicamento> ToList()
        {
            return _items.ToList();
        }
    }

